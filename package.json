{
  "name": "@richardmcquiston01/custom-catalog-component",
  "version": "0.2.1",
  "description": "Framework-agnostic, accessible catalog view: a two-column layout with search, filters, sorting, and a Grid / Carousel / List switch.",
  "license": "Apache-2.0",
  "author": "Richard McQuiston <richard.mcquiston@gmail.com> (https://richardmcquiston.com/)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RichardMcQuiston01/catalog-component.git"
  },
  "funding": {
    "type": "individual",
    "url": "https://donate.stripe.com/00w5kD3Gj1Xo9v7gVOcs800"
  },
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/catalog.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && bun run scripts/copy-css.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepublishOnly": "bun run typecheck && bun run test && bun run build"
  },
  "keywords": [
    "catalog",
    "filter",
    "carousel",
    "accessible",
    "wcag",
    "typescript"
  ],
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "^21.0.1",
    "@types/bun": "^1.4.3",
    "happy-dom": "^21.0.1",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  }
}
